# --- DATABASE ---
# SQLite database path. Prisma resolves this path relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# --- APP ---
# Production domain. This is used inside email verification links, sitemap and robots.
APP_URL="https://toshmirzayev-inomjon.online"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# --- ADMIN ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"

# --- EMAIL (SMTP) ---
# Gmail requires an App Password, not your normal Gmail password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="InomjonFolio <your-email@gmail.com>"

# --- VERIFICATION ---
EMAIL_VERIFICATION_EXPIRY="15"
