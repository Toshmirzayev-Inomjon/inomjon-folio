generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          String    @default("USER")
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  messages      Message[]
  tokens        VerificationToken[]
}

model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id          String   @id @default("main")
  name        String
  headline    String
  bio         String
  headlineUz  String?
  headlineEn  String?
  headlineRu  String?
  bioUz       String?
  bioEn       String?
  bioRu       String?
  heroImage   String
  cvUrl       String?
  telegramUrl String?
  githubUrl   String?
  linkedinUrl String?
  instagramUrl String?
  careerStartDate DateTime?
  happyClientsCount Int      @default(20)
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String
  techStack   String
  visitUrl    String?
  githubUrl   String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  group     String?
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LocationSetting {
  id        String   @id @default("main")
  latitude  Float
  longitude Float
  iframeUrl String?
  updatedAt DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  body      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
